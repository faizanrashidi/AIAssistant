<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <Button
        android:id="@+id/btnSetupPermissions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Grant Permissions" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnTorchOn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Torch ON" />

        <Button
            android:id="@+id/btnTorchOff"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Torch OFF" />
    </LinearLayout>

    <Button
        android:id="@+id/btnMic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Start Voice Input" />

    <EditText
        android:id="@+id/etUserPrompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Type your command..." />

    <Button
        android:id="@+id/btnSendToAI"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Send to AI" />

    <TextView
        android:id="@+id/tvAiResponse"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="16dp"
        android:textSize="16sp"
        android:text="AI Output here..." />

</LinearLayout>
