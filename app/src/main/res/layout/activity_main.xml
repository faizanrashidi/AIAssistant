<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI OS System Agent"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"/>

        <Button
            android:id="@+id/btnSetupPermissions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GRANT ALL PERMISSIONS &amp; SETUP"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"/>

        <!-- Quick System Tools -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="System Controls"
            android:textStyle="bold"
            android:layout_marginTop="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnTorchOn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Torch ON" />

            <Button
                android:id="@+id/btnTorchOff"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Torch OFF" />
        </LinearLayout>

        <!-- AI Assistant Chat UI -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI Brain &amp; Encrypted Memory"
            android:textStyle="bold"
            android:layout_marginTop="20dp"/>

        <EditText
            android:id="@+id/etUserPrompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Likhien (e.g. Mera favorite color Blue hai)"
            android:layout_marginTop="8dp"/>

        <Button
            android:id="@+id/btnSendToAI"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ask AI / Save Memory"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/tvAiResponse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AI Output Yahan Aayega..."
            android:padding="12dp"
            android:background="#EFEFEF"
            android:layout_marginTop="12dp"/>

    </LinearLayout>
</ScrollView>
